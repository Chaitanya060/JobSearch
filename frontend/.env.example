# Frontend env — copy to .env.local and fill in. Only VITE_* values are bundled
# into the browser, so NEVER put secrets here (no Supabase/R2/Admin keys).
# Firebase web config is browser-safe; restrict authorized domains in Firebase.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Cloudflare Worker API base (phase 2). Leave blank while using the mock layer.
VITE_API_BASE_URL=http://localhost:8787
